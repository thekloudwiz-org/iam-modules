{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ComputeServices",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "ecs:*",
        "lambda:*",
        "application-autoscaling:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NetworkingServices",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:*",
        "route53:*",
        "cloudfront:*",
        "wafv2:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "StorageServices",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "dynamodb:*",
        "ecr:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DatabaseServices",
      "Effect": "Allow",
      "Action": [
        "rds:*",
        "docdb:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityServices",
      "Effect": "Allow",
      "Action": [
        "kms:*",
        "secretsmanager:*",
        "ssm:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MonitoringServices",
      "Effect": "Allow",
      "Action": [
        "logs:*",
        "cloudwatch:*",
        "sns:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CICDServices",
      "Effect": "Allow",
      "Action": [
        "codebuild:*",
        "codepipeline:*",
        "codestar-connections:*",
        "codedeploy:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CertificateServices",
      "Effect": "Allow",
      "Action": [
        "acm:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IAMServices",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:ListRoles",
        "iam:PassRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IdentityServices",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}