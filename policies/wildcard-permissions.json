{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ComputeServices",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "ecs:*",
        "lambda:*",
        "application-autoscaling:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NetworkingServices",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:*",
        "route53:*",
        "cloudfront:*",
        "wafv2:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "StorageServices",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "dynamodb:*",
        "ecr:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DatabaseServices",
      "Effect": "Allow",
      "Action": [
        "rds:*",
        "docdb:*",
        "elasticache:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityServices",
      "Effect": "Allow",
      "Action": [
        "kms:*",
        "secretsmanager:*",
        "ssm:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MonitoringServices",
      "Effect": "Allow",
      "Action": [
        "logs:*",
        "cloudwatch:*",
        "sns:*",
        "xray:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CICDServices",
      "Effect": "Allow",
      "Action": [
        "codebuild:*",
        "codepipeline:*",
        "codestar-connections:*",
        "codedeploy:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CertificateServices",
      "Effect": "Allow",
      "Action": [
        "acm:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IAMServices",
      "Effect": "Allow",
      "Action": [
        "iam:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IdentityServices",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AnalyticsServices",
      "Effect": "Allow",
      "Action": [
        "kinesis:*",
        "firehose:*",
        "glue:*",
        "athena:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BillingServices",
      "Effect": "Allow",
      "Action": [
        "budgets:*",
        "ce:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AuthenticationServices",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:*",
        "cognito-identity:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityAuditServices",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:*",
        "guardduty:*",
        "securityhub:*",
        "config:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "APIServices",
      "Effect": "Allow",
      "Action": [
        "apigateway:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MessagingServices",
      "Effect": "Allow",
      "Action": [
        "sqs:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTServices",
      "Effect": "Allow",
      "Action": [
        "iot:*",
        "greengrass:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EventServices",
      "Effect": "Allow",
      "Action": [
        "events:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BackupServices",
      "Effect": "Allow",
      "Action": [
        "backup:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ResourceManagement",
      "Effect": "Allow",
      "Action": [
        "resource-groups:*",
        "tag:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TimestreamServices",
      "Effect": "Allow",
      "Action": [
        "timestream-influxdb:*"
      ],
      "Resource": "*"
    }
  ]
}
